<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>strikesprite</AssemblyName>
    <RootNamespace>StrikeSprite</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Game install. Override with -p:Sts2GameDir=... or the STS2_GAME_DIR env var. -->
    <Sts2GameDir Condition="'$(Sts2GameDir)' == '' and '$(STS2_GAME_DIR)' != ''">$(STS2_GAME_DIR)</Sts2GameDir>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">D:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <Sts2DataDir>data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2BinDir>$(Sts2GameDir)\$(Sts2DataDir)</Sts2BinDir>
  </PropertyGroup>

  <!--
    Reference the assemblies the game already ships instead of NuGet packages:
    no restore traffic, and no risk of compiling against a different Godot/Harmony
    version than the one actually loaded at runtime.
  -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2BinDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2BinDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2BinDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="mod_manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
